+           "FlatElementSurface::set_element_normals6: need 18 ncell values");
+  el_nmls6 = v;
+  nml_mode = mode_quad;
+}
+
+void FlatElementSurface::set_normal_fn (const NormalFn& fn) {
+  nml_fn = fn;
